# CaseThread local environment configuration (non-web platforms only).
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Web builds cannot read files at runtime — pass the same values there via:
#   flutter run -d chrome --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# The anon/publishable key is safe to embed in the client: access control is
# enforced by Row Level Security in the database (Architecture.md §9), not by
# key secrecy. NEVER put the service-role key here.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional build flavor (dev | staging | prod) — defaults to dev.
# APP_FLAVOR=dev
