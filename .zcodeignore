#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets — never commit real environment values (Rules.md §10).
.env
.env.*
!.env.example

# Supabase local dev artifacts
supabase/.temp/

# ZCode session artifacts
.zcode/

# Node (supabase CLI devDependency)
node_modules/
# Flutter DevTools
/devtools_options.yaml
# Local CI/debug log captures — never commit (a pasted log once
# carried a secret key; Rules.md §10)
p2*.txt
p[0-9]log*.txt
p6*.txt

